<?php

/**
 * @file
 * Install, update, and uninstall functions for the DCPAS Chatbot module.
 *
 * Creates the three custom tables used to store the RAG corpus:
 *   dcpas_chatbot_chunks         — document chunks with metadata
 *   dcpas_chatbot_embeddings     — float vectors (stored as JSON)
 *   dcpas_chatbot_index_versions — crawl/index run history
 */

/**
 * Implements hook_schema().
 */
function dcpas_chatbot_schema(): array {
  // Note: dcpas_chatbot_pg_embeddings is NOT listed here because it requires
  // the pgvector PostgreSQL extension and a vector column type unsupported by
  // Drupal's schema API. It is created by hook_update_9801() on PostgreSQL
  // installs only, and populated by ingestion/migrate_to_pgvector.py.
  return [
    'dcpas_chatbot_chunks' => [
      'description' => 'RAG document chunks extracted from the indexed corpus.',
      'fields' => [
        'chunk_id'    => ['type' => 'varchar', 'length' => 64,  'not null' => TRUE, 'description' => 'Stable SHA-based chunk identifier.'],
        'source_url'  => ['type' => 'text',    'size' => 'big', 'not null' => TRUE, 'description' => 'Source page or document URL.'],
        'title'       => ['type' => 'varchar', 'length' => 500, 'not null' => FALSE, 'default' => '', 'description' => 'Page title.'],
        'chunk_index' => ['type' => 'int',     'not null' => TRUE, 'default' => 0, 'description' => 'Position within source document.'],
        'text'        => ['type' => 'text',    'size' => 'big', 'not null' => TRUE, 'description' => 'Chunk plain text.'],
        'char_count'  => ['type' => 'int',     'not null' => FALSE, 'default' => 0],
        'text_hash'   => ['type' => 'varchar', 'length' => 64,  'not null' => FALSE, 'default' => '', 'description' => 'SHA-256 of chunk text for corpus integrity verification.'],
        'created_at'  => ['type' => 'varchar', 'length' => 32,  'not null' => FALSE, 'default' => ''],
      ],
      'primary key' => ['chunk_id'],
      'indexes' => [
        'source_url_prefix' => [['source_url', 191]],
      ],
    ],

    'dcpas_chatbot_embeddings' => [
      'description' => 'Embedding vectors for each chunk, stored as JSON arrays.',
      'fields' => [
        'chunk_id'    => ['type' => 'varchar', 'length' => 64,  'not null' => TRUE, 'description' => 'Foreign key to dcpas_chatbot_chunks.'],
        'model'       => ['type' => 'varchar', 'length' => 100, 'not null' => FALSE, 'default' => ''],
        'dimensions'  => ['type' => 'int',     'not null' => FALSE, 'default' => 0],
        'vector_json' => ['type' => 'text',    'size' => 'big', 'not null' => TRUE, 'description' => 'Embedding vector as a JSON-encoded float array.'],
        'embedded_at' => ['type' => 'varchar', 'length' => 32,  'not null' => FALSE, 'default' => ''],
      ],
      'primary key' => ['chunk_id'],
    ],

    'dcpas_chatbot_index_versions' => [
      'description' => 'Audit log of corpus index runs.',
      'fields' => [
        'id'          => ['type' => 'serial', 'not null' => TRUE],
        'version'     => ['type' => 'varchar', 'length' => 64,  'not null' => TRUE, 'description' => 'Version string (e.g. date-based).'],
        'chunk_count' => ['type' => 'int',     'not null' => FALSE, 'default' => 0],
        'indexed_at'  => ['type' => 'varchar', 'length' => 32,  'not null' => FALSE, 'default' => ''],
        'notes'       => ['type' => 'varchar', 'length' => 500, 'not null' => FALSE, 'default' => ''],
      ],
      'primary key' => ['id'],
    ],
  ];
}

/**
 * Implements hook_uninstall().
 */
function dcpas_chatbot_uninstall(): void {
  \Drupal::configFactory()->getEditable('dcpas_chatbot.settings')->delete();
}

/**
 * Create the pgvector embeddings table on PostgreSQL installs (Sprint 8).
 *
 * This update hook runs on ALL installs but only creates the table when the
 * default database driver is pgsql. On MySQL/SQLite it is a no-op.
 *
 * Prerequisites (PostgreSQL only):
 *   1. CREATE EXTENSION IF NOT EXISTS vector;
 *   2. Run ingestion/migrate_to_pgvector.py to populate the table.
 *   3. Switch vector_store_backend to 'pgvector' in admin settings.
 *
 * The vector dimension (1536) matches text-embedding-3-small.
 * Adjust if using a different embedding model.
 */
function dcpas_chatbot_update_9801(): void {
  $db = \Drupal::database();
  if ($db->databaseType() !== 'pgsql') {
    // Not PostgreSQL — pgvector table not applicable.
    return;
  }
  // Raw DDL required — Drupal schema API does not support vector column type.
  $db->query("
    CREATE TABLE IF NOT EXISTS {dcpas_chatbot_pg_embeddings} (
      chunk_id   VARCHAR(64)      NOT NULL PRIMARY KEY,
      model      VARCHAR(100)     DEFAULT '',
      dimensions INTEGER          DEFAULT 0,
      embedding  vector(1536)     NOT NULL,
      embedded_at VARCHAR(32)     DEFAULT ''
    )
  ");
  $db->query("
    CREATE INDEX IF NOT EXISTS dcpas_pg_emb_ivfflat
    ON {dcpas_chatbot_pg_embeddings}
    USING ivfflat (embedding vector_cosine_ops)
    WITH (lists = 100)
  ");
}

/**
 * Add text_hash column to dcpas_chatbot_chunks for corpus integrity (Sprint 5).
 */
function dcpas_chatbot_update_9501(): void {
  $schema = \Drupal::database()->schema();
  if (!$schema->fieldExists('dcpas_chatbot_chunks', 'text_hash')) {
    $schema->addField('dcpas_chatbot_chunks', 'text_hash', [
      'type'        => 'varchar',
      'length'      => 64,
      'not null'    => FALSE,
      'default'     => '',
      'description' => 'SHA-256 of chunk text for corpus integrity verification.',
    ]);
  }
}

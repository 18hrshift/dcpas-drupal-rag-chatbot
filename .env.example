# Copy to .env and fill in your values

# OpenAI (standard) — for local dev
OPENAI_API_KEY=sk-...

# Azure OpenAI — swap these in for FedRAMP production deployment
# OPENAI_API_BASE=https://{resource-name}.openai.azure.com/openai
# OPENAI_API_VERSION=2024-02-01
# EMBEDDING_DEPLOYMENT=text-embedding-3-small   # your Azure deployment name
# CHAT_DEPLOYMENT=gpt-4                         # your Azure deployment name

# Model names (standard OpenAI defaults — override for Azure deployment names)
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o

# Crawler settings
TARGET_URL=https://dcpas.osd.mil
MAX_PAGES=500
CRAWL_DELAY=1.5

# Local storage
DB_PATH=data/index.sqlite
PAGES_DIR=data/pages
PDFS_DIR=data/pdfs
